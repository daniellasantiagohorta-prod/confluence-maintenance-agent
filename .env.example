# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.
#
# Load into your shell with:
#   export $(grep -v '^#' .env | xargs)
# Or use direnv (recommended): https://direnv.net/

# ─── Required ────────────────────────────────────────────────────────────────

# Atlassian API token — used for both Confluence and Jira
# Get one at: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_EMAIL=you@springhealth.com
CONFLUENCE_TOKEN=your-atlassian-api-token-here

# Anthropic API key — used for Claude analysis
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ─── Slack ────────────────────────────────────────────────────────────────────
# Create a Slack App at https://api.slack.com/apps
# Bot Token Scopes needed: channels:history, channels:read, groups:history,
#   groups:read, im:history, im:read, im:write, chat:write
#
# SLACK_BOT_TOKEN  — enables channel search (--phase 1) and bot DMs (--listen)
# SLACK_APP_TOKEN  — Socket Mode token (xapp-...) — required only for --listen
#                    Enable Socket Mode in your app settings, add connections:write scope
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here

# Channels to search for context (comma-separated, no # prefix needed)
SLACK_CHANNELS=product-ops,po2-updates,member-growth-team,eng-platform,design-research

# How far back to look in Slack (days)
SLACK_DAYS_BACK=21

# ─── Jira ─────────────────────────────────────────────────────────────────────
# Uses the same CONFLUENCE_EMAIL + CONFLUENCE_TOKEN above — no extra credentials.
# Set which Jira projects to search (comma-separated project keys):
JIRA_PROJECT_KEYS=PO,PE,MX,CV,ENG

# How far back to look in Jira (days)
JIRA_DAYS_BACK=30

# ─── Granola ──────────────────────────────────────────────────────────────────
# Option A: Keep the Granola Mac app running — the agent will query its local API.
#
# Option B: Export meeting notes from Granola to a folder and point here:
# GRANOLA_EXPORT_DIR=/Users/you/Documents/GranolaExports
#
# How far back to look in meeting notes (days)
GRANOLA_DAYS_BACK=30
